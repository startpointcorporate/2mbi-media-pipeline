FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/contracts ./packages/contracts
COPY services/editorial-worker ./services/editorial-worker
RUN corepack enable && pnpm install --frozen-lockfile
RUN pnpm --filter @2mbi/editorial-worker build

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/services/editorial-worker/dist ./dist
COPY --from=builder /app/services/editorial-worker/package.json ./
COPY --from=builder /app/node_modules ./node_modules
CMD ["node", "dist/index.js"]
