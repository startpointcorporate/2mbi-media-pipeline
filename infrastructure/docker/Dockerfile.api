FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/contracts ./packages/contracts
COPY apps/media-pipeline-api ./apps/media-pipeline-api
RUN corepack enable && pnpm install --frozen-lockfile
RUN pnpm --filter @2mbi/media-pipeline-api build

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/apps/media-pipeline-api/dist ./dist
COPY --from=builder /app/apps/media-pipeline-api/package.json ./
COPY --from=builder /app/node_modules ./node_modules
EXPOSE 3001
CMD ["node", "dist/index.js"]
