# PostgreSQL (shared 2MBI infrastructure)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/media_pipeline_db

# Redis (shared 2MBI infrastructure)
REDIS_URL=redis://:redispass@localhost:6379

# Redis Streams (prefixed for shared instance)
REDIS_MEDIA_EVENTS_STREAM=2mbi:media:events
REDIS_MEDIA_TASKS_STREAM=2mbi:media:tasks
REDIS_EDITORIAL_TASKS_STREAM=2mbi:media:editorial:tasks
REDIS_DEAD_LETTER_STREAM=2mbi:media:dead-letter

# MinIO (shared 2MBI infrastructure)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=2mbi-media
MINIO_USE_SSL=false

# Media Delivery
MEDIA_PUBLIC_BASE_URL=https://media.2mbiweb.com
MEDIA_PRIVATE_URL_TTL_SECONDS=900

# Ollama (shared 2MBI infrastructure)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=180000
OLLAMA_TEMPERATURE=0
EDITORIAL_AI_MAX_CONCURRENCY=1

# Postiz (shared 2MBI infrastructure)
POSTIZ_BASE_URL=https://postiz.2mbiweb.com
POSTIZ_API_KEY=

# Whisper / faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_FILTER=true
WHISPER_MAX_CONCURRENCY=1
WHISPER_MODEL_CACHE_PATH=/models/whisper

# Clip generation
CLIP_LEAD_IN_SECONDS=0.5
CLIP_LEAD_OUT_SECONDS=0.8
CLIP_MIN_DURATION_SECONDS=15
CLIP_MAX_DURATION_SECONDS=60

# Auth (API key par client)
CLIENTS_CONFIG='[{"tenantId":"konektag","apiKey":"konektag_key","apiSecret":"konektag_secret"},{"tenantId":"clapscelebrity","apiKey":"claps_key","apiSecret":"claps_secret"},{"tenantId":"2mbiweb","apiKey":"2mbiweb_key","apiSecret":"2mbiweb_secret"}]'
INTERNAL_API_KEY=internal_secret_key

# Ports
MEDIA_PIPELINE_PORT=3001
ORCHESTRATOR_PORT=3002
WORKER_PORT=3003
